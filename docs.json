      "href": "/get-the-plugin"
    }
  },
  "footer": {
    "socials": {}
  },
  "redirects": [
    {
      "source": "/cli/init",
      "destination": "/cli/login"
    },
    {
      "source": "/introduction",
      "destination": "/how-it-works"
    },
    {
      "source": "/try-the-demo",
      "destination": "/get-the-plugin"
    }
