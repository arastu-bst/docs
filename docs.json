{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "nowrun",
  "colors": {
    "primary": "#ef7025",
    "light": "#eec9bc",
    "dark": "#4fa1ab"
  },
  "favicon": "/favicon.svg",
