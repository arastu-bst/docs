          "get-the-plugin",
          "how-it-works"
        ]
      },
      {
        "group": "Add your app",
        "pages": [
          "quickstart",
          "setup/account",
          "setup/cli-install",
          "setup/authentication",
          "deploying/describe-your-app",
          "deploying/your-first-deploy",
          "deploying/supported-engines",
          "deploying/managing-apps"
        ]
      },
      {
        "group": "Add app functions",
        "pages": [
          "sdk/app-functions"
        ]
      },
      {
        "group": "CLI reference",
        "pages": [
          "cli/overview",
          "cli/login",
          "cli/deploy"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "help/faq",
          "help/troubleshooting",
          "help/for-ai-agents"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "nowrun.io",
        "href": "https://nowrun.io"
      }
    ],
    "primary": {
      "type": "button",
